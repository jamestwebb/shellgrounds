# Shellgrounds — environment configuration
#
# Deploying with the "Deploy to Netlify" button? You will be prompted for the
# three variables marked PROMPTED below and you do not need this file at all.
# This file is for running the site on your own machine.
#
# Copy it to `.env` and fill it in:   cp .env.example .env
# Data lives in Netlify Blobs — there is no database to provision.

# PROMPTED · REQUIRED
# The password you say out loud in class. It gates handle creation only.
# Pick something easy to say and hear. Change it each term.
CLASS_PASSWORD="choose-a-new-password-each-term"

# PROMPTED · REQUIRED IF YOU WANT AN INSTRUCTOR ACCOUNT
# Your handle(s), comma separated. These accounts see the instructor dashboard:
# the answer key, who is stuck, and the gradebook export.
# Empty or unset means nobody is an instructor.
ADMIN_HANDLES=""

# PROMPTED · REQUIRED FOR ANY INSTRUCTOR ACCOUNT
# A second password, known only to you. Set it BEFORE you announce the class
# password, and use it when you register your own handle.
#
# Every student has CLASS_PASSWORD, and handles are first-come. Without this,
# a student could register the handle you listed in ADMIN_HANDLES before you
# did and walk away with the whole gradebook. That is not hypothetical — it was
# demonstrated against this codebase. Registering an instructor handle now needs
# this code as well as the class password.
#
# An account only becomes an instructor by proving this code — being named in
# ADMIN_HANDLES is checked too, but is never sufficient on its own. If you
# already registered without it, set this and use the "I am the instructor"
# box again, or POST /api/claim-instructor.
INSTRUCTOR_SETUP_CODE=""

# REQUIRED · not prompted, because nobody should have to invent key material
# HMAC secret for session tokens and per-student flags. Generate one with:
#   openssl rand -hex 32
# Never commit the real value. Rotating it signs everyone out and regenerates
# every flag.
SESSION_SECRET=""

# OPTIONAL
# Which modules students can see, comma separated. Leave blank for all of them.
# Valid ids: forensics-cli-101, linux-fundamentals, windows-cmd-essentials
ENABLED_PACKS=""

# OPTIONAL
# Blob store name. Change it (e.g. shellgrounds-spring2027) to start a term with
# an empty class. The old store's data stays until you delete it with
# `netlify blobs:delete`. Changing this orphans every existing score, so only
# change it at a term boundary. A site deployed before the rename may still set
# GAUNTLET_STORE instead; that name is still read, and still works.
SHELLGROUNDS_STORE="shellgrounds-fall2026"

# OPTIONAL · local development only
# Points the browser at a functions server running on another port. The local
# dev script sets this for you.
# VITE_API_BASE="http://127.0.0.1:9999/api"
