# The Warren — Environment Configuration
# ALL FOUR variables are REQUIRED in deployed environments. There are no fallbacks:
# missing DATABASE_URL / CLASS_PASSWORD / SESSION_SECRET makes the API return 500 on purpose.

# Neon Serverless Postgres Connection String (tables are created automatically on first use)
DATABASE_URL="postgresql://user:password@ep-sample-123456.us-east-2.aws.neon.tech/warren?sslmode=require"

# Class password announced in lecture (gates handle creation only). Rotate each semester.
CLASS_PASSWORD="choose-a-new-password-each-semester"

# HMAC secret for session tokens and per-user flags. Generate a long random value, e.g.:
#   openssl rand -hex 32
# Never commit the real value; rotating it invalidates all sessions and regenerates all flags.
SESSION_SECRET=""

# Comma-separated admin handles with access to the instructor dashboard.
# Empty or unset means NO admins. Register these handles yourself before announcing the site.
ADMIN_HANDLES=""
