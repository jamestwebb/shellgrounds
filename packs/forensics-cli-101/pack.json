{
  "id": "forensics-cli-101",
  "name": "Forensics CLI 101: The Aurora Case",
  "version": "1.0.0",
  "platforms": [
    "linux",
    "windows"
  ],
  "icon": "🧭",
  "description": "A digital-forensics case worked from the command line, from arriving at the bench to carving a file out of a disk image. Written for a cyber-forensics course, and it teaches general CLI skill through the case. Assumes you have met a terminal before.",
  "// reveal": "The picture the class uncovers together, one square per find. Embedded, so a pack stays one file. Raster only -- never SVG.",
  "reveal": "data:image/webp;base64,",
  "briefing": {
    "heading": "The Aurora Case",
    "body": "You are first on scene at the bench. The exhibits are logged, the machine is yours, and the case will be built from what you can show — not from what you remember doing.\n\nForensics work is ordinary command-line work done carefully. You will look at files without changing them, prove what a file really is rather than what it claims to be, and carry a number from one command into the next without writing it down wrong.\n\nAct VI moves to the seized Windows laptop and does the same work again in cmd.exe, because a case does not choose its operating system for you.",
    "youWillLearn": [
      "Get your bearings on an unfamiliar machine",
      "Read a file’s true type from its magic bytes, not its extension",
      "Take and check a forensic hash",
      "Search a filesystem with grep and find",
      "Build multi-stage pipelines that answer a real question",
      "Read a partition table and carry a sector offset",
      "Do the same work again in Windows CMD"
    ]
  },
  "linux": {
    "home": "/home/examiner",
    "user": "examiner",
    "host": "fieldlab",
    "shell": "bash"
  },
  "windows": {
    "home": "C:\\Users\\Examiner",
    "user": "Examiner",
    "shell": "cmd"
  },
  "theme": {
    "accent": "#10b981",
    "titleBar": "FIELDLAB TTY1",
    "sidebarTone": "emerald"
  },
  "messages": {
    "unsimulated": "That is a real command, but not simulated in this lab. Type `help` to see what works here.",
    "unsupportedSyntax": "That shell syntax is not simulated here."
  },
  "courseTools": {
    "dd": "a raw imaging tool used for disk acquisition",
    "hexdump": "a hex viewer used to inspect file headers",
    "xxd": "a hex viewer used to inspect file headers",
    "sha1sum": "a hashing tool (this simulator has md5sum and sha256sum)",
    "openssl": "a crypto toolkit used for hashing and certificates",
    "mmls": "a Sleuth Kit tool for reading partition tables",
    "fsstat": "a Sleuth Kit tool for filesystem details",
    "fls": "a Sleuth Kit tool for listing files, including deleted ones",
    "icat": "a Sleuth Kit tool for extracting file content by inode",
    "mactime": "a Sleuth Kit tool for building timelines",
    "tsk_recover": "a Sleuth Kit recovery tool",
    "exiftool": "a metadata reader for documents and images",
    "volatility": "a memory-forensics framework",
    "vol": "the Volatility 3 command for memory forensics",
    "binwalk": "a firmware and embedded-file carver",
    "foremost": "a file-carving tool",
    "photorec": "a file-recovery tool",
    "testdisk": "a partition-recovery tool",
    "autopsy": "the graphical front end to the Sleuth Kit",
    "wireshark": "a network protocol analyzer",
    "tshark": "the command-line version of Wireshark",
    "sqlite3": "a command-line SQLite client"
  },
